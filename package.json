{
  "name": "@nearpay-money/cli",
  "version": "0.2.0",
  "description": "NearPay developer CLI (test mode): log in with a device code, stream events and forward them to localhost re-signed like webhooks, trigger real test-mode events, list and resend events.",
  "keywords": [
    "nearpay",
    "cli",
    "payments",
    "webhooks",
    "near-intents",
    "crypto",
    "developer-tools",
    "test-mode"
  ],
  "homepage": "https://docs.nearpay.money",
  "bugs": {
    "url": "https://github.com/nearpay-money/nearpay-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nearpay-money/nearpay-cli.git"
  },
  "license": "Apache-2.0",
  "author": "NearPay <nearpaydotmoney@gmail.com> (https://nearpay.money)",
  "type": "module",
  "bin": {
    "nearpay": "./dist/cli.js"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "build:binaries": "node scripts/build-binaries.mjs",
    "test": "vitest run --project unit",
    "test:integration": "pnpm build && vitest run --project integration",
    "test:all": "pnpm build && vitest run",
    "coverage": "vitest run --project unit --coverage",
    "verify": "pnpm typecheck && pnpm lint && pnpm coverage && pnpm test:integration"
  },
  "dependencies": {
    "@napi-rs/keyring": "2.1.2",
    "@nearpay-money/spec": "0.5.0",
    "commander": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@nearpay-money/node": "0.4.0",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "2.1.9",
    "fast-check": "4.10.2",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
